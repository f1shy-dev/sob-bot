{
  "name": "sob-bot",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "typecheck": "tsgo --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "discord.js": "^14.26.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260407.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.7.0"
  }
}
